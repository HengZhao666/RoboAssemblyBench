@@ -0,0 +1,226 @@
+extends: fabrica_stool_circular_ur5e_staged
+task_name: fabrica_stool_circular_ur5e_physical
+prompt: Assemble the canonical Fabrica circular stool with continuous physical UR5e grasping, transport, insertion, release, and both-arm home.
+
+# Pure physical route derived from the Plumbers C01 framework: friction grasps
+# only (no fixed joints, locks, pose/velocity writes, collision/gravity toggles).
+policy_auto_grasp: false
+physics_scene:
+  enable_external_forces_every_iteration: true
+  enable_stabilization: true
+
+robots:
+  - name: franka_left
+    preserve_continuous_arm_joints: true
+    gripper_min_openness: 0.0
+    gripper_drive_kp: 7500.0
+    gripper_drive_kd: 173.0
+    gripper_drive_max_effort: null
+    gripper_require_drive_readback: true
+    gripper_pad_static_friction: 1.0
+    gripper_pad_dynamic_friction: 0.8
+    # Open issue (see handoff): caps can only be pinched on their top 3-5 mm.
+    # Rigid pads lose that grip (smoke22), damping 60 drops leg 7 (smoke23),
+    # 5000/15 can rattle the cap (smoke21 cap 4). Best known: 5000/15.
+    gripper_pad_contact_stiffness: 5000.0
+    gripper_pad_contact_damping: 15.0
+    # Gravity sag of the position drive scales 1/kp: 80000 -> 0.42 mm,
+    # 160000 (S23) -> 0.22 mm at the leg grasp, enough to give single-finger
+    # contact on pocket-held parts (smoke07/08). 4x S23, same kd=sqrt(200 kp).
+    arm_drive_kp: 640000.0
+    arm_drive_kd: 11313.708498984761
+  - name: franka_right
+    preserve_continuous_arm_joints: true
+    gripper_min_openness: 0.0
+    gripper_drive_kp: 7500.0
+    gripper_drive_kd: 173.0
+    gripper_drive_max_effort: null
+    gripper_require_drive_readback: true
+    gripper_pad_static_friction: 1.0
+    gripper_pad_dynamic_friction: 0.8
+    # Compliant pads (Plumbers C01 base hand): a part held by its tray pocket
+    # cannot self-centre; rigid pads turn ~0.2 mm offset into 0/19 N (smoke06).
+    gripper_pad_contact_stiffness: 5000.0
+    gripper_pad_contact_damping: 15.0
+    # Gravity sag of the position drive scales 1/kp: 80000 -> 0.42 mm,
+    # 160000 (S23) -> 0.22 mm at the leg grasp, enough to give single-finger
+    # contact on pocket-held parts (smoke07/08). 4x S23, same kd=sqrt(200 kp).
+    arm_drive_kp: 640000.0
+    arm_drive_kd: 11313.708498984761
+
+fabrica_canonical:
+  continuous_physics: true
+  # Fabrica pinch points sit 160 mm (base) / 170 mm (moving parts) from the
+  # converted Robotiq frame. Native USD finger FK (outputs/stool_physical/
+  # pad_fk.py) puts the inner-pad centroid ~121 mm (75 mm gap) / ~130 mm
+  # (18 mm gap) from base_link; Plumbers' 143 mm at a 40 mm gap fixes the
+  # control-frame offset at ~15 mm. Shift grasps so pads land on the pinch.
+  # Deeper (0.136) drove the fingers into the tray pocket walls (smoke03:
+  # stalled at a 78 mm gap, zero target force); 0.143 closes freely to 75.3 mm.
+  physical_base_pad_center_m: 0.143
+  # Seek past the nominal preset: the 75 mm base needs q ~0.131 vs 0.098.
+  physical_close_force_max_seek: 0.08
+  # 45-degree tilted grasps hold the finger ~0.0011 rad behind its command;
+  # the Plumbers 0.001 rad seek lead then never advances (smoke02/04).
+  physical_close_force_max_command_lead: 0.004
+  # The native finger-sweep preflight (physical_pickup_fixture_clearance) was
+  # tried on caps: with the 2 mm recentre allowance and its triangle-inequality
+  # motion bound it rejects anything within ~14 mm (smoke13: 3.4 mm at open).
+  # Hexagonal legs: align the strict-contact box with the pinched flats
+  # (smoke11: left finger on box x, right on box y, both 4.5 N opposing).
+  physical_contact_box_align_to_grasp_parts: ['3', '7', '5', '1']
+  # Caps (18x18x30 mm) sit in tray pockets with only their tops exposed, so
+  # the pads grip the top ~3 mm band of two opposing faces (PhysX contacts at
+  # z=12..15 mm of a 15 mm half-height, smoke12). 10 mm deeper hits the tray
+  # (smoke14: zero-force stall). The modelled pad samples lie 35-50 mm above the
+  # cap, so qualify the opposing pair from the measured contact points instead.
+  # Finish seating while still grasped. The last insert phase otherwise ends
+  # ~5 mm high (8 mm / 50.5 mm axial tolerance); released parts dropped and
+  # tilted 0.8-4.2 deg, and cap 0 could not seat on a 4.2-deg leg 1 (R03).
+  # Axial (not released high) is the purpose; lateral/orientation stay loose
+  # because the socket leg shifts under insertion and caps twist about the
+  # round peg in their edge grip (R04 cap 0: 6.3 deg). Acceptance unchanged.
+  physical_seat_before_release:
+    '3': {position_m: 0.003, axial_m: 0.0015, lateral_m: 0.002, orientation_rad: 0.14, stable_steps: 24}
+    '7': {position_m: 0.003, axial_m: 0.0015, lateral_m: 0.002, orientation_rad: 0.14, stable_steps: 24}
+    '6': {position_m: 0.003, axial_m: 0.0015, lateral_m: 0.002, orientation_rad: 0.14, stable_steps: 24}
+    '4': {position_m: 0.003, axial_m: 0.0015, lateral_m: 0.002, orientation_rad: 0.14, stable_steps: 24}
+    '5': {position_m: 0.003, axial_m: 0.0015, lateral_m: 0.002, orientation_rad: 0.14, stable_steps: 24}
+    '1': {position_m: 0.003, axial_m: 0.0015, lateral_m: 0.002, orientation_rad: 0.14, stable_steps: 24}
+    '0': {position_m: 0.003, axial_m: 0.0015, lateral_m: 0.002, orientation_rad: 0.14, stable_steps: 24}
+    '8': {position_m: 0.003, axial_m: 0.0015, lateral_m: 0.002, orientation_rad: 0.14, stable_steps: 24}
+  # Caps follow their real leg, not the base-rebased nominal: released legs
+  # lean 0.7-4.7 deg in their sockets (peg top 1-7 mm off); cap 0 could not
+  # seat in R03/R04. Socket table from the task contract.
+  physical_rebase_targets_to_socket: {'6': '3', '4': '7', '0': '1', '8': '5'}
+  # Caps expose only their top 3-5 mm in the tray, and that edge grip either
+  # slips or rattles (smoke21-23). Edge-pick, set the cap upright on a free
+  # board spot (0.56, -0.02), release, retreat, then re-pick 10 mm deeper with
+  # the same Fabrica grasp orientation before the normal transport/insertion.
+  physical_cap_regrasp:
+    parts: ['6', '4', '0', '8']
+    staging_offset_from_assembly_m: [-0.14, 0.13]
+    place_clearance_m: 0.0015
+    hover_height_m: 0.08
+    regrasp_deeper_m: 0.010
+    place_position_tolerance_m: 0.003
+    # Staging spots = the R05-validated cells (25 mm lattice from the board
+    # origin); with the flat board collider below the holes no longer matter.
+    board_hole_free_cell: {origin_xy_m: [0.47, -0.14], pitch_m: 0.025}
+  # The optical board is a plain 925x625x10 mm slab (mesh vertices only at z=0
+  # and z=-10 mm). As an exact triangle mesh its top has vertices only on the
+  # 6.6 mm hole rims, so SDF parts are contact-sampled there and a set-down cap
+  # rests ~12 deg tilted (smoke24-27). A box collider has the identical top face
+  # (holes filled; nothing in Stool uses them) and replaces R05's extra 3 mm
+  # staging pad. Plumbers keeps its triangle-mesh board.
+  physical_board_collision: boundingCube
+  # Same surface friction as R05's staging pad (0.8/0.6). At the default 0.5 a
+  # set-down cap crept 7 mm and tilted to 2.9 deg before the regrasp closed,
+  # leaving the jaw 8.8 mm off the cap (> 7 mm attach tolerance, smoke36).
+  physical_board_friction: {static: 0.8, dynamic: 0.6}
+  # Servo caps at their own centre: lateral error at the shared assembly origin
+  # (~100 mm below a cap) froze insertion depth once the cap tilted a few
+  # tenths of a degree on its peg (smoke19/24/25).
+  physical_servo_reference_point_parts: ['6', '4', '0', '8']
+  # 10 g caps: carry at the Plumbers part-0 band (4/5 N) instead of 6/8 N;
+  # squeezing the 3 mm tray edge grip harder made it chatter and drop (smoke29).
+  physical_move_hold_force_control:
+    '6': {low: 4.0, target: 5.0}
+    '4': {low: 4.0, target: 5.0}
+    '0': {low: 4.0, target: 5.0}
+    '8': {low: 4.0, target: 5.0}
+  # Bounded contact recovery as Plumbers C01 used for its pins: the strict
+  # check flickered to contact_missing with both fingers at 5.4-5.8 N while the
+  # cap touched the pad (smoke31). Retains <=24 steps, never claims a grasp.
+  physical_contact_recovery:
+    '6': {steps: 24, maximum_surface_gap_m: 0.0005}
+    '4': {steps: 24, maximum_surface_gap_m: 0.0005}
+    '0': {steps: 24, maximum_surface_gap_m: 0.0005}
+    '8': {steps: 24, maximum_surface_gap_m: 0.0005}
+  physical_strict_contact_from_force_points_parts: ['6', '4', '0', '8', '1']
+  # The last leg and caps are released beside seated neighbours. A full open
+  # swept a finger into leg 3 and the retreat tipped it and dropped cap 6
+  # (smoke34). Open to 0.34 (~33 mm jaw, ~7 mm/side over an 18 mm grip), require
+  # zero finger force, and keep that aperture for a 100 mm vertical retreat.
+  physical_limited_release:
+    parts: ['1', '0', '8']
+    openness: 0.34
+    minimum_openness: 0.33
+    retreat_distance_m: 0.10
+  # Fabrica grasp centres sit 9.4 (cap 6, works), 4.8 (cap 4: pads closed above
+  # it, R01/smoke17), 7.9 (cap 8), 12.0 (cap 0) and 3.2 mm (leg 1 peg) below the
+  # part top. Bring the shallow ones to cap 6's verified depth along the
+  # near-vertical approach: pad centre = 0.1703 - (9.4 mm - depth).
+  physical_move_pad_centers_m:
+    '4': 0.1657
+    '8': 0.1688
+    '1': 0.1641
+    # Cap 0 (12.0 mm, tilted 28.7 deg in its pocket) touched the pocket first (R02).
+    '0': 0.1729
+  # Moving parts keep Fabrica's pinch (170 mm): the 57 mm native pad then
+  # spans the pinch with the fingertip only ~7 mm beyond it. A 145 mm pad
+  # centre pushed the tips ~32 mm into the tray pockets (smoke09 part 3).
+  physical_idle_hold_anchor: true
+  stabilize_fixture_parts: false
+  skip_terminal_retreat: false
+  skip_terminal_park: false
+  physical_settle_steps: 120
+  physical_wait_step_limit: 30
+  close_force_stability:
+    enabled: true
+    window_steps: 5
+    hysteresis_margin: 0.5
+  physical_rotation_speed: 0.15
+  physical_rotation_acceleration: 0.45
+  # The governor brakes inside its lookahead: effective transport turn rate is
+  # ~sqrt(a*0.9*lookahead) = 0.13 rad/s at 0.010 (4.3k-step leg transport,
+  # smoke12). 0.030 -> ~0.22 rad/s; slip guards (3 mm / 5 deg) unchanged.
+  physical_rotation_lookahead: 0.030
+  physical_transport_rotation_speed: 0.35
+  physical_transport_rotation_acceleration: 1.80
+  physical_terminal_home:
+    enabled: true
+    joint_tolerance: 0.025
+    # Empty-arm home only (after release/retreat): 0.72 rad/s at 240 Hz.
+    max_joint_step: 0.003
+  hold_force_control:
+    enabled: true
+    low: 6.0
+    target: 8.0
+    soft_limit: 14.0
+    unload: 18.0
+    hard_limit: 40.0
+    soft_limit_action: limit_and_slow
+    soft_limit_motion_scale: 0.5
+    joint_rate: 0.025
+    unload_rate: 0.025
+    max_command_lead: 0.001
+    max_seek: 0.03
+    max_closing_travel: null
+    filter_tau: 0.02
+    stable_steps: 24
+    resume_steps: 48
+    recovery_timeout_steps: 480
+    slip_window_steps: 48
+    slip_growth: 0.0001
+    slip_preload: true
+
+# Debug-only (smoke tests, never a formal round): pick cap 6 right after the
+# base to test cap grasps in ~12 min. Its insertion cannot succeed (no leg).
+profiles:
+  cap_first:
+    task_name: fabrica_stool_circular_ur5e_physical_cap_first
+    fabrica_canonical:
+      assembly_step_order: ['6', '3', '7', '4', '5', '1', '0', '8']
+  cap4_first:
+    task_name: fabrica_stool_circular_ur5e_physical_cap4_first
+    fabrica_canonical:
+      assembly_step_order: ['4', '3', '7', '6', '5', '1', '0', '8']
+  leg3_cap6:
+    task_name: fabrica_stool_circular_ur5e_physical_leg3_cap6
+    fabrica_canonical:
+      assembly_step_order: ['3', '6', '7', '4', '5', '1', '0', '8']
+  leg7_cap4:
+    task_name: fabrica_stool_circular_ur5e_physical_leg7_cap4
+    fabrica_canonical:
+      assembly_step_order: ['7', '4', '3', '6', '5', '1', '0', '8']
