+def cap_regrasp_targets(task: dict, targets: list[dict], spec: dict) -> list[dict]:
+    """World staging targets: the part upright (assembled orientation) resting on the board."""
+    cfg = _cap_regrasp_settings(spec)
+    if cfg is None:
+        return []
+    by_name = {t['name']: t for t in targets}
+    parts = {str(p['part_id']): p for p in task['parts']}
+    dx, dy = cfg['staging_offset_from_assembly_m']
+    result = []
+    for pid in cfg['parts']:
+        assembled = by_name[f'part_{pid}_assembled']
+        lo, hi = parts[pid]['bbox_min'], parts[pid]['bbox_max']
+        bottom = float(lo[2])
+        orientation = [float(v) for v in assembled['orientation']]
+        # Put the part's footprint centre on a hole-free cell centre of the
+        # perforated board (a footprint edge over a hole tipped caps 12 deg).
+        centre_local = [0.5 * (float(a) + float(b)) for a, b in zip(lo, hi)]
+        centre_offset = quat_rotate(orientation, centre_local)
+        want = [float(assembled['position'][0]) + dx + centre_offset[0],
+                float(assembled['position'][1]) + dy + centre_offset[1]]
+        ox, oy = cfg['cell_origin']; pitch = cfg['cell_pitch']
+        snapped = [ox + pitch * round((want[0] - ox) / pitch), oy + pitch * round((want[1] - oy) / pitch)]
+        base = [snapped[0] - centre_offset[0], snapped[1] - centre_offset[1],
+                float(assembled['position'][2]) + cfg['pad_height'] - bottom + cfg['place_clearance_m']]
+        result.append(dict(name=f'part_{pid}_staged', reference='world', position=list(base), orientation=orientation))
+        hover = [base[0], base[1], base[2] + cfg['hover_height_m']]
+        result.append(dict(name=f'part_{pid}_stage_hover', reference='world', position=hover, orientation=list(orientation)))
+    return result
+
