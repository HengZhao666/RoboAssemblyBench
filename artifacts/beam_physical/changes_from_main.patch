+class CommandSpaceFeedback(unittest.TestCase):
+    def fixture(self, enabled=True, offset=(78e-6,87e-6,305e-6)):
+        adapter,task,native,state,act=replay.FinalActionRecenterSafety().fixture(
+            initial=0.,consistent=True,feedback=True)
+        spec=inspect.getclosurevars(act).nonlocals['spec']
+        if enabled:
+            spec.update(close_recenter_feedback_command_space=True,
+                        close_recenter_feedback_max_tracking_offset=.001)
+        raw=task.robots['left'].controllers['arm_ik_controller']._kinematics_solver.get_kinematics_solver()
+        raw.compute_inverse_kinematics=lambda frame,position,orientation,**kw:(np.r_[position,np.zeros(3)],True)
+        raw.compute_forward_kinematics=lambda frame,q:(np.asarray(q[:3]),np.eye(3))
+        pose=lambda:{'position':native['q'][:3].copy(),'orientation':np.array([1.,0.,0.,0.])}
+        adapter._current_robot_pose=lambda **kw:pose()
+        adapter._target_pose=lambda **kw:pose()
+        records=[]
+        adapter._debug_close_gate_step=lambda **kw:records.append(copy.deepcopy(kw['detail']))
+        act()  # The existing force controller plans a genuine pending micro.
+        self.assertEqual(state['force_recenter_pending']['lifecycle'],'planned')
+        prior=np.r_[offset,np.zeros(3)]
+        state['hold_q']=prior.copy()
+        adapter._remember_arm_command(task,'left',prior)
+        return adapter,task,native,state,act,spec,records,prior
+
+    def run_plant(self,enabled=True,response=.065,frozen=False):
+        adapter,task,native,state,act,spec,records,prior=self.fixture(enabled)
+        bias=-prior.copy()
+        queued=prior.copy()  # One interval of command delay.
+        target=None;history=[]
+        for tick in range(101,345):
+            task.step_counter=task.phase_step_counter=tick
