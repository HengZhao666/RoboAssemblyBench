+def _cap_regrasp_settings(spec: dict) -> dict | None:
+    raw = spec.get('physical_cap_regrasp')
+    if raw is None:
+        return None
+    required = {'parts', 'staging_offset_from_assembly_m', 'place_clearance_m', 'hover_height_m',
+                'regrasp_deeper_m', 'place_position_tolerance_m', 'board_hole_free_cell'}
+    if not isinstance(raw, dict) or not required <= set(raw) <= required | {'staging_pad'}:
+        raise ValueError(f'physical_cap_regrasp requires exactly {sorted(required)} (+ optional staging_pad)')
+    parts = raw['parts']
+    offset = [float(v) for v in raw['staging_offset_from_assembly_m']]
+    if not isinstance(parts, list) or not parts or not all(isinstance(p, str) for p in parts):
+        raise ValueError('physical_cap_regrasp.parts must list part ids')
+    if len(offset) != 2 or not all(math.isfinite(v) for v in offset) or math.hypot(*offset) < 0.12:
+        raise ValueError('physical_cap_regrasp staging offset must be a finite xy at least 120 mm from the assembly')
+    bounds = {'place_clearance_m': (0.0, 0.005), 'hover_height_m': (0.04, 0.15),
+              'regrasp_deeper_m': (0.0, 0.025), 'place_position_tolerance_m': (0.001, 0.006)}
+    cell = raw['board_hole_free_cell']
+    if (not isinstance(cell, dict) or set(cell) != {'origin_xy_m', 'pitch_m'}
+            or len(cell['origin_xy_m']) != 2 or not 0.005 <= float(cell['pitch_m']) <= 0.1):
+        raise ValueError('board_hole_free_cell requires origin_xy_m (cell-centre lattice origin) and pitch_m')
+    out = dict(parts=list(parts), staging_offset_from_assembly_m=offset,
+               cell_origin=[float(v) for v in cell['origin_xy_m']], cell_pitch=float(cell['pitch_m']))
+    pad = raw.get('staging_pad')
+    if pad is None:
+        out['pad_height'] = 0.0
+        out['pad_margin'] = None
+    elif (not isinstance(pad, dict) or set(pad) != {'height_m', 'margin_m'}
+            or not 0.001 <= float(pad['height_m']) <= 0.01 or not 0.005 <= float(pad['margin_m']) <= 0.05):
+        raise ValueError('staging_pad requires height_m in [1, 10] mm and margin_m in [5, 50] mm')
+    else:
+        out['pad_height'] = float(pad['height_m'])
+        out['pad_margin'] = float(pad['margin_m'])
+    for key, (lo, hi) in bounds.items():
+        value = float(raw[key])
+        if not math.isfinite(value) or not lo < value <= hi:
