+        data=json.loads((Path(__file__).parent/'fixtures/beam_v201_v203_reference.json').read_text())['v203_close_failure']
+        record=data['recenter_lifecycle'][0]
+        current=np.array(record['motion_start_position_world'])
+        delta=np.array(record['motion_delta_world'])
+        nominal=np.array(data['close_gates'][-1]['command_target_position'])
+        anchor=nominal-delta
+        state={'recenter_anchor_position_world':anchor.copy(),
+               'force_recenter_pending':{'lifecycle':'planned','motion_delta_world':delta.copy()}}
+        self.assertGreater(np.linalg.norm(nominal-current-delta),.0002)
+        target=Adapter._consistent_recenter_target(state=state,nominal_target=nominal,current_position=current,max_offset=.002)
+        np.testing.assert_allclose(target,current+delta,atol=1e-14)
+        np.testing.assert_array_equal(state['recenter_anchor_position_world'],anchor)
+        later=Adapter._consistent_recenter_target(state=state,nominal_target=nominal,current_position=current+.0001,max_offset=.002)
+        np.testing.assert_array_equal(later,target)
+
+    def test_full_act_keeps_one_goal_and_finishes_with_evolving_lag(self):
+        adapter,task,native,state,act=FinalActionRecenterSafety().fixture(initial=.000204,consistent=True)
+        anchor=copy.deepcopy(state['contact_arm_anchor'])
+        first=act()
+        # Native lag persists between planning and actual issuance.
+        native['q'][0]=.00015
+        task.step_counter=task.phase_step_counter=101
