+        target=pending['motion_target_position_world'].copy()
+        self.assertAlmostEqual(target[1],.000125)
+        self.assertAlmostEqual(pending['issued_command_tcp_position_world'][1],target[1])
+        self.assertAlmostEqual(pending['motion_start_position_world'][1],.00015)
+        for tick in range(102,145):
+            native['q'] += .5*(np.array(action['arm_joint_controller'][0])-native['q'])
+            task.step_counter=task.phase_step_counter=tick
+            action=act()
