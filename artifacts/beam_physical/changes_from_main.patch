+            or skill.get('requires_held_object')
+            or skill.get('servo_target_object_pose') is True):
+        return False
+    # 36 showed negligible step gain but measurable CAD cost on already-fast
+    # 8--15mm travel. Retain those original controllers and reuse their checks.
+    if float(skill.get('cartesian_position_step', .01)) > .004:
+        return False
+    skill.update(beam_free_transit=True, require_success=True, fallback='fail', requires_held_object=False,
+                 requires_empty_arm=True, empty_arm_phase_handoff=True,
+                 use_arm_ik_controller=False,
+                 cartesian_position_command_warm_start=True,
+                 cartesian_position_command_lookahead=.02,
+                 cartesian_position_command_accumulation_step=.004,
+                 cartesian_position_command_slowdown_distance=.02,
+                 cartesian_position_command_near_lookahead=.001,
+                 cartesian_position_step=max(.004, float(skill.get('cartesian_position_step', .004))))
+    # Raise only explicitly tiny publication limits to 1.92 rad/s at240Hz.
+    # Preserve larger/default limits; actual tracking and
+    # existing angular/force limits are independent and remain in force.
+    for key in ('max_joint_step', 'max_command_joint_step'):
+        if key in skill:
+            skill[key] = max(.008, float(skill[key]))
+    return True
