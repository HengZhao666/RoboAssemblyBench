+class Feedback(unittest.TestCase):
+    def run_model(self, enabled, bias, frozen=False):
+        adapter,task,native,state,act=replay.FinalActionRecenterSafety().fixture(
+            initial=.000204,consistent=True,feedback=enabled)
+        action=act()
+        # Measured state changes before the actual issuance, as in r29.
+        native['q'][0]=.00015
+        target=None
+        for tick in range(101,360):
+            task.step_counter=task.phase_step_counter=tick
+            action=act()
+            if '__local_skill_failure__' in action:break
+            pending=state.get('force_recenter_pending')
+            if target is None and pending and pending.get('lifecycle')=='final_action_issued':
+                target=pending['motion_target_position_world'].copy()
+            if target is not None and pending is not None:
+                np.testing.assert_array_equal(pending['motion_target_position_world'],target)
+            if not frozen:
+                # First-order lag plus a constant drive/load offset; no
+                # ideal instantaneous tracking or simulated contact response.
+                requested=np.array(action['arm_joint_controller'][0]);requested[0]+=bias
+                native['q'] += .4*(requested-native['q'])
+            if target is not None and pending is None:break
+        return adapter,task,native,state,action,target,act
+
+    def test_v205_fixed_target_still_times_out_with_drive_offset(self):
+        *_,action,_,_=self.run_model(False,.00008)
