+extends: fabrica_stool_circular_ur5e_staged
+task_name: fabrica_stool_circular_ur5e_physical
+prompt: Assemble the canonical Fabrica circular stool with continuous physical UR5e grasping, transport, insertion, release, and both-arm home.
+
+# Pure physical route derived from the Plumbers C01 framework: friction grasps
+# only (no fixed joints, locks, pose/velocity writes, collision/gravity toggles).
+policy_auto_grasp: false
+physics_scene:
+  enable_external_forces_every_iteration: true
+  enable_stabilization: true
+
+robots:
+  - name: franka_left
+    preserve_continuous_arm_joints: true
+    gripper_min_openness: 0.0
+    gripper_drive_kp: 7500.0
+    gripper_drive_kd: 173.0
+    gripper_drive_max_effort: null
+    gripper_require_drive_readback: true
+    gripper_pad_static_friction: 1.0
+    gripper_pad_dynamic_friction: 0.8
+    # Compliant pads (Plumbers C01 base hand): a part held by its tray pocket
+    # cannot self-centre; rigid pads turn ~0.2 mm offset into 0/19 N (smoke06).
+    gripper_pad_contact_stiffness: 5000.0
+    gripper_pad_contact_damping: 15.0
+    # Gravity sag of the position drive scales 1/kp: 80000 -> 0.42 mm,
+    # 160000 (S23) -> 0.22 mm at the leg grasp, enough to give single-finger
+    # contact on pocket-held parts (smoke07/08). 4x S23, same kd=sqrt(200 kp).
+    arm_drive_kp: 640000.0
+    arm_drive_kd: 11313.708498984761
+  - name: franka_right
+    preserve_continuous_arm_joints: true
+    gripper_min_openness: 0.0
+    gripper_drive_kp: 7500.0
+    gripper_drive_kd: 173.0
+    gripper_drive_max_effort: null
+    gripper_require_drive_readback: true
+    gripper_pad_static_friction: 1.0
+    gripper_pad_dynamic_friction: 0.8
+    # Compliant pads (Plumbers C01 base hand): a part held by its tray pocket
+    # cannot self-centre; rigid pads turn ~0.2 mm offset into 0/19 N (smoke06).
+    gripper_pad_contact_stiffness: 5000.0
+    gripper_pad_contact_damping: 15.0
+    # Gravity sag of the position drive scales 1/kp: 80000 -> 0.42 mm,
+    # 160000 (S23) -> 0.22 mm at the leg grasp, enough to give single-finger
+    # contact on pocket-held parts (smoke07/08). 4x S23, same kd=sqrt(200 kp).
+    arm_drive_kp: 640000.0
+    arm_drive_kd: 11313.708498984761
+
+fabrica_canonical:
+  continuous_physics: true
+  # Fabrica pinch points sit 160 mm (base) / 170 mm (moving parts) from the
+  # converted Robotiq frame. Native USD finger FK (outputs/stool_physical/
+  # pad_fk.py) puts the inner-pad centroid ~121 mm (75 mm gap) / ~130 mm
+  # (18 mm gap) from base_link; Plumbers' 143 mm at a 40 mm gap fixes the
+  # control-frame offset at ~15 mm. Shift grasps so pads land on the pinch.
+  # Deeper (0.136) drove the fingers into the tray pocket walls (smoke03:
+  # stalled at a 78 mm gap, zero target force); 0.143 closes freely to 75.3 mm.
+  physical_base_pad_center_m: 0.143
+  # Seek past the nominal preset: the 75 mm base needs q ~0.131 vs 0.098.
+  physical_close_force_max_seek: 0.08
+  # 45-degree tilted grasps hold the finger ~0.0011 rad behind its command;
+  # the Plumbers 0.001 rad seek lead then never advances (smoke02/04).
+  physical_close_force_max_command_lead: 0.004
+  # The native finger-sweep preflight (physical_pickup_fixture_clearance) was
+  # tried on caps: with the 2 mm recentre allowance and its triangle-inequality
+  # motion bound it rejects anything within ~14 mm (smoke13: 3.4 mm at open).
+  # Hexagonal legs: align the strict-contact box with the pinched flats
+  # (smoke11: left finger on box x, right on box y, both 4.5 N opposing).
+  physical_contact_box_align_to_grasp_parts: ['3', '7', '5', '1']
+  # Caps (18x18x30 mm) sit in tray pockets with only their tops exposed, so
+  # the pads grip the top ~3 mm band of two opposing faces (PhysX contacts at
+  # z=12..15 mm of a 15 mm half-height, smoke12). 10 mm deeper hits the tray
+  # (smoke14: zero-force stall). The modelled pad samples lie 35-50 mm above the
+  # cap, so qualify the opposing pair from the measured contact points instead.
+  physical_strict_contact_from_force_points_parts: ['6', '4', '0', '8', '1']
+  # Fabrica grasp centres sit 9.4 (cap 6, works), 4.8 (cap 4: pads closed above
+  # it, R01/smoke17), 7.9 (cap 8), 12.0 (cap 0) and 3.2 mm (leg 1 peg) below the
+  # part top. Bring the shallow ones to cap 6's verified depth along the
+  # near-vertical approach: pad centre = 0.1703 - (9.4 mm - depth).
+  physical_move_pad_centers_m:
+    '4': 0.1657
+    '8': 0.1688
+    '1': 0.1641
+  # Moving parts keep Fabrica's pinch (170 mm): the 57 mm native pad then
+  # spans the pinch with the fingertip only ~7 mm beyond it. A 145 mm pad
+  # centre pushed the tips ~32 mm into the tray pockets (smoke09 part 3).
+  physical_idle_hold_anchor: true
+  stabilize_fixture_parts: false
+  skip_terminal_retreat: false
+  skip_terminal_park: false
+  physical_settle_steps: 120
+  physical_wait_step_limit: 30
+  close_force_stability:
+    enabled: true
+    window_steps: 5
+    hysteresis_margin: 0.5
+  physical_rotation_speed: 0.15
+  physical_rotation_acceleration: 0.45
+  # The governor brakes inside its lookahead: effective transport turn rate is
+  # ~sqrt(a*0.9*lookahead) = 0.13 rad/s at 0.010 (4.3k-step leg transport,
+  # smoke12). 0.030 -> ~0.22 rad/s; slip guards (3 mm / 5 deg) unchanged.
+  physical_rotation_lookahead: 0.030
+  physical_transport_rotation_speed: 0.35
+  physical_transport_rotation_acceleration: 1.80
+  physical_terminal_home:
+    enabled: true
+    joint_tolerance: 0.025
+    # Empty-arm home only (after release/retreat): 0.72 rad/s at 240 Hz.
+    max_joint_step: 0.003
+  hold_force_control:
+    enabled: true
+    low: 6.0
+    target: 8.0
+    soft_limit: 14.0
+    unload: 18.0
+    hard_limit: 40.0
+    soft_limit_action: limit_and_slow
+    soft_limit_motion_scale: 0.5
+    joint_rate: 0.025
+    unload_rate: 0.025
+    max_command_lead: 0.001
+    max_seek: 0.03
+    max_closing_travel: null
+    filter_tau: 0.02
+    stable_steps: 24
+    resume_steps: 48
+    recovery_timeout_steps: 480
+    slip_window_steps: 48
+    slip_growth: 0.0001
+    slip_preload: true
+
+# Debug-only (smoke tests, never a formal round): pick cap 6 right after the
+# base to test cap grasps in ~12 min. Its insertion cannot succeed (no leg).
+profiles:
+  cap_first:
+    task_name: fabrica_stool_circular_ur5e_physical_cap_first
+    fabrica_canonical:
+      assembly_step_order: ['6', '3', '7', '4', '5', '1', '0', '8']
+  cap4_first:
+    task_name: fabrica_stool_circular_ur5e_physical_cap4_first
+    fabrica_canonical:
+      assembly_step_order: ['4', '3', '7', '6', '5', '1', '0', '8']
