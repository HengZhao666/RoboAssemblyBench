+    def test_original_two_newton_target_discards_three_sample_margin_window(self):
+        state,out=self.replay(2.,self.cycle)
+        self.assertFalse(any(x['updated'] for x in out))
+        self.assertEqual([x.get('confirmation_steps') for x in out[5:8]],[1,2,3])
+        self.assertEqual(out[8]['reason'],'bilateral')
+        self.assertNotIn('force_recenter_pending',state)
+
+    def test_interior_target_preserves_confirmation_through_soft_unloading(self):
+        state,out=self.replay(8.,self.cycle)
+        self.assertTrue(out[-1]['updated'])
+        self.assertEqual(len(out),6)
+        self.assertTrue(all(not x['updated'] for x in out[:5]))
+        self.assertEqual(out[-1]['motion_mode'],'force_margin')
+        np.testing.assert_allclose(out[-1]['motion_delta_world'],[0.,-.000025,0.])
+        self.assertLessEqual(state['force_recenter_travel'],.002)
