+            new_faces.extend(pieces)
+            new_parents.extend([parent]*len(pieces))
+        triangles = np.asarray(new_faces, dtype=np.int64)
+        parents = np.asarray(new_parents, dtype=np.int64)
+        rounds += 1
+    raise ValueError('Refinement did not converge within 32 rounds')
