+                skill['target_object_reference_point'] = list(centre)
+                if phase['name'].endswith('_stage_place'):
+                    skill['target_object_reference_point_for_convergence'] = True
+                touched += 1
+        if not touched:
+            raise ValueError(f'part {pid}: no held servo phases for a reference point')
