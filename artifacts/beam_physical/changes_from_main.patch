+def _apply_empty_retreat_budget(phase, skill):
+    # Follow Plumbers' motion-budget floor, using Beam's measured late pace.
+    # No endpoint, convergence tolerance, command rate or physics gate changes.
+    if (skill.get('name') == 'ur5e_retreat_vertical'
+            and skill.get('empty_arm_phase_handoff')
+            and skill.get('gripper_command') == 'open'
+            and not skill.get('requires_held_object')):
+        phase['timeout_steps'] = max(int(phase['timeout_steps']), EMPTY_RETREAT_MIN_TIMEOUT_STEPS)
