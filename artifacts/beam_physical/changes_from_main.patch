+"""Beam roles/geometry with Plumbers-style supported versus unloaded checks.
+
+The opt-in contract was explicitly selected by the user on 2026-11-10.
+No body state, force threshold, grasp anchor or collision setting is modified.
+"""
+import copy
+import os
+
+PROFILE = 'plumbers_staged_v1'
+GRASP_POINT_PROFILE = 'plumbers_staged_v2'
+EMPTY_RETREAT_MIN_TIMEOUT_STEPS = 6960
