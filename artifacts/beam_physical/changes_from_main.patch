+def _bind_empty_joint_skill(skill):
+    if skill.get('name') not in {'move_arm_to_joint_positions', 'ur5e_move_arm_to_joint_positions'}:
+        return False
+    if skill.get('gripper_command') != 'open' or skill.get('requires_held_object'):
+        raise ValueError('Beam staged joint clearance/home must be explicitly open and unloaded')
+    from toolkits.factory_dual_franka_assembly.ur5e_skill_api import UR5E_ASSEMBLY_ADAPTER
+    # The v169 recipe predates this atom's metadata registration. Bind every
+    # generated occurrence explicitly, including partner homes and final holds.
+    skill.setdefault('adapter', UR5E_ASSEMBLY_ADAPTER)
+    # Reuse the adapter's bounded published-command cache instead of restarting
+    # each small increment at the measured joints. Preserve existing empty-arm
+    # handoffs, authored endpoints and publication/track caps.
+    skill['reference_mode'] = 'command'
+    skill.update(requires_held_object=False, requires_empty_arm=True,
+                 require_success=True, fallback='fail')
+    return True
+
+
+def _apply_empty_joint_speed_profile(skill):
+    if skill.get('name') not in {'move_arm_to_joint_positions', 'ur5e_move_arm_to_joint_positions'}:
+        return False
+    if not (skill.get('requires_empty_arm') and skill.get('gripper_command') == 'open'
+            and skill.get('requires_held_object') is False):
+        raise ValueError('Joint transit speed requires explicit open unloaded ownership')
+    floor = .004 if int(skill.get('joint_target_stable_steps', 8)) >= 24 else .008
+    for key in ('max_joint_step', 'max_command_joint_step', 'max_command_wrist_joint_step'):
+        if key in skill:
+            skill[key] = max(floor, float(skill[key]))
+    skill['beam_fast_empty_joint'] = True
+    return True
+
+
+def validate_staged_skill_bindings(phases, task_metadata, robots):
+    """Use the production normalization/default merge before any engine starts."""
+    import importlib
+    from types import SimpleNamespace
+    from toolkits.factory_dual_franka_assembly.local_skills import (
+        LocalSkillExecutor, normalize_local_skill_spec,
+    )
+    from toolkits.factory_dual_franka_assembly.ur5e_skill_api import UR5eAssemblySkillAPI
+    known = {definition.runtime_name for definition in UR5eAssemblySkillAPI.definitions}
+    known.add('ur5e_move_arm_to_joint_positions')
+    executor = LocalSkillExecutor()
+    task = SimpleNamespace(cfg=SimpleNamespace(task_metadata=task_metadata))
+    checked = []
+    for phase in phases:
+        for robot in robots:
+            robot = robot['name'] if isinstance(robot, dict) else robot
+            spec = normalize_local_skill_spec(phase, robot)
+            if spec is None:
+                continue
+            spec = executor._merge_task_defaults(task, spec)
+            ref = spec.get('adapter') or spec.get('adapter_class')
+            if spec['name'] not in known or not ref:
+                raise ValueError(f"Unbound Beam local skill: {phase['name']}/{robot}/{spec['name']}")
+            module, attribute = str(ref).split(':', 1)
+            adapter = getattr(importlib.import_module(module), attribute)
+            if not callable(getattr(adapter, 'act', None)):
+                raise ValueError(f'Beam adapter has no action consumer: {ref}')
+            checked.append(dict(phase=phase['name'], robot=robot, skill=spec['name'], adapter=ref))
+    return checked
