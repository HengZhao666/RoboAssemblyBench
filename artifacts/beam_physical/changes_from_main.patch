+"""Real adapter act/gates/limits with an explicit delayed toy plant.
+
+The contact reader and kinematics are doubles. No test qualifies a physical grasp
+or substitutes for the native contact/force/geometry acceptance.
+"""
+import copy
+import inspect
+import json
+from pathlib import Path
+import unittest
+
+import numpy as np
+import test_beam_weak_side_recenter as replay
+from toolkits.factory_dual_franka_assembly.plumbers_block_ur5e_skills import UR5eAssemblyAtomicSkillAdapter as Adapter
+
