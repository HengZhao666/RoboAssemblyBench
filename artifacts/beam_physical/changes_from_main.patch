+"""Offline, conforming midpoint refinement of existing collision triangles.
+
+This changes tessellation only: no smoothing, projection, hole filling, hulls,
+physics parameters, or runtime state access. Parent indices support independent
+surface/mass checks before a generated asset is admitted.
+"""
+from numbers import Real
+import math
+import numpy as np
