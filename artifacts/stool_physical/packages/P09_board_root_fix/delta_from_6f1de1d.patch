+def _seat_only_gate_settings(spec: dict) -> dict:
+    """Per-part final-insertion seating gate that leaves success tolerances alone.
+
+    Unlike physical_insertion_release_tolerances (which also tightens the
+    success entry), this only makes the last grasped insertion phase reach the
+    seated pose before release. Stool parts otherwise release ~5 mm high and
+    drop into their sockets, tilting by up to 4 degrees (R03 leg 1).
+    """
+    raw = spec.get('physical_seat_before_release', {})
+    if not isinstance(raw, dict):
+        raise ValueError('physical_seat_before_release must map part ids to gate settings')
+    allowed = {'position_m', 'axial_m', 'lateral_m', 'orientation_rad', 'stable_steps'}
+    result = {}
+    for part_id, settings in raw.items():
+        if not isinstance(settings, dict) or set(settings) != allowed:
+            raise ValueError(f'physical_seat_before_release[{part_id}] requires {sorted(allowed)}')
+        for key in allowed - {'stable_steps'}:
+            value = settings[key]
+            limit = 0.2 if key == 'orientation_rad' else 0.01
+            if isinstance(value, bool) or not math.isfinite(float(value)) or not 0 < float(value) <= limit:
+                raise ValueError(f'physical_seat_before_release[{part_id}].{key} must be in (0, {limit}]')
+        if type(settings['stable_steps']) is not int or settings['stable_steps'] < 2:
+            raise ValueError('physical_seat_before_release needs at least two stable steps')
+        result[str(part_id)] = dict(settings)
+    return result
+
