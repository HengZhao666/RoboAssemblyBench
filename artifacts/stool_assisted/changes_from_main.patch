+"""Offline regression against a real pre-migration worker snapshot.
+
+This does not initialize a simulator or claim worker preflight. --real-loader
+also exercises the actual recipe inheritance/compiler/metadata merge using the
+server runtime dependencies, without creating an Isaac SimulationContext.
+"""
+from __future__ import annotations
+
+import argparse
+import copy
+import importlib.util
+import json
+from pathlib import Path
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--baseline-worker-json', type=Path, required=True)
+    parser.add_argument('--real-loader', action='store_true')
+    parser.add_argument('--output', type=Path)
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parents[2]
+    module_path = root / 'roboassemblybench/core/fabrica_assisted_compiler.py'
+    spec = importlib.util.spec_from_file_location('fabrica_assisted_compiler', module_path)
+    adapter = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(adapter)
+    snapshots = json.loads(args.baseline_worker_json.read_text())
+    snapshot = snapshots[0] if isinstance(snapshots, list) else snapshots
+    catalog = json.loads((root / 'roboassemblybench/assets/Fabrica/canonical_7_bundles/canonical_tasks.json').read_text())
+    task = catalog['tasks']['stool_circular']
+    source = {
+        'robots': copy.deepcopy(snapshot['robot_metadata']),
+        'objects': copy.deepcopy(snapshot['object_metadata']),
+        'targets': [dict(name=name, **value) for name, value in snapshot['target_poses'].items()],
+        'success': copy.deepcopy(snapshot['success_criteria']),
+        'phases': copy.deepcopy(snapshot['phase_specs']),
+        'max_steps': snapshot['max_steps'],
+        'metadata': copy.deepcopy(snapshot['benchmark_metadata']),
+    }
+    original = copy.deepcopy(source)
+    result = adapter.adapt_stool_assisted_recipe(
+        source, task, {'assembly': 'stool_circular', 'preshape_gripper_position_tolerance': .025})
+    checks = []
+
+    def check(name, ready):
+        if not ready:
+            raise AssertionError(name)
+        checks.append(name)
+
+    check('original_nine_success_criteria_unchanged', result['success'] == original['success'])
+    check('original_assets_unchanged', result['objects'] == original['objects'])
+    expected_robots = copy.deepcopy(original['robots'])
+    for robot in expected_robots:
+        robot['preserve_continuous_arm_joints'] = True
+    check('robot_only_native_sdk_winding_flag_changed', result['robots'] == expected_robots)
+    check('original_targets_unchanged', result['targets'] == original['targets'])
+    check('original_phase_order_retained', [p['name'] for p in result['phases'][:-1]]
+          == [p['name'] for p in original['phases']])
+    contract = result['metadata']['fabrica_assisted_contract']
+    check('nine_objects_and_catalog_order', len(set(contract['objects'])) == 9
+          and contract['assembly_order'] == ['fabrica_stool_circular_' + p
+                                           for p in ('2', '3', '7', '6', '4', '5', '1', '0', '8')])
+    old_release = next(p for p in original['phases'] if p['name'] == 'base_2_release_and_lock')
+    release = next(p for p in result['phases'] if p['name'] == 'base_2_release_and_lock')
+    check('base_rebase_preserved', release['lock'][0]['rebase_targets']
+          == old_release['lock'][0]['rebase_targets'] == contract['base_rebase_targets'])
+    check('canonical_contact_pairs_preserved', contract['assembly_contact_pairs'] == [
+        ['fabrica_stool_circular_' + str(s['move_part']),
+         'fabrica_stool_circular_' + str(s['socket_part'])] for s in task['assembly_steps']])
+    check('native_contract_retained_every_phase', all(
+        p['fabrica_assisted_contract'] == contract for p in result['phases']))
+    check('stool_values_derived_from_original_controller',
+          contract['contact_stable_physics_steps'] == 12
+          and contract['release_stable_physics_steps'] == 72
+          and contract['final_stable_physics_steps'] == 72
+          and contract['install_position_step_m'] == .00025
+          and contract['install_orientation_step_rad'] == .012
+          and abs(contract['gripper_open_joint_tolerance_rad'] - .02) < 1e-12)
+    check('original_strict_contact_and_native_action_outlet', all(
+        s.get('use_arm_ik_controller') is False and not s.get('beam_assisted_visual_pinch')
+        and not s.get('continuous_physics')
+        for p in result['phases'] for s in [p.get('local_skill', {})] if s))
+    check('no_beam_path_or_home_targets_added', not any(
+        p.get('beam_assisted_home_targets') or 'visual_support' in p['name']
+        for p in result['phases']))
+    check('final_all_nine_released_open_and_native_window',
+          set(result['phases'][-1]['beam_assisted_installed_parts']) == set(contract['objects'])
+          and set(result['phases'][-1]['gripper_commands'].values()) == {'open'}
+          and result['phases'][-1]['advance']['physics_stable_steps'] == 72)
+
+    def reject(name, mutation):
+        invalid = copy.deepcopy(original)
+        mutation(invalid)
+        try:
+            adapter.adapt_stool_assisted_recipe(invalid, task, {'assembly': 'stool_circular'})
+        except ValueError:
+            checks.append(name)
+        else:
+            raise AssertionError('Failed to reject: ' + name)
+
+    reject('missing_success_object_rejected', lambda value: value['success'].pop())
+    reject('duplicate_success_object_rejected', lambda value: value['success'].__setitem__(
+        0, copy.deepcopy(value['success'][1])))
+    reject('missing_base_rebase_rejected', lambda value: next(
+        p for p in value['phases'] if p['name'] == 'base_2_release_and_lock')['lock'][0].pop('rebase_targets'))
+    reject('unsupported_carry_rejected', lambda value: value['phases'][0].update(kinematic_carry=[{'enabled': True}]))
+    if args.real_loader:
+        from roboassemblybench.core.task_registry import load_task_recipe
+        loaded = load_task_recipe('fabrica_stool_circular_ur5e_staged')
+        check('real_loader_compiler_metadata_survives',
+              loaded['metadata']['fabrica_assisted_contract']['adapter'] == adapter.ADAPTER)
+        check('real_loader_original_gates_preserved', loaded['success'] == original['success'])
+        check('real_loader_preserves_native_sdk_winding', all(
+            robot.get('preserve_continuous_arm_joints') is True for robot in loaded['robots']))
+        check('real_loader_phase_contracts_match_metadata', all(
+            p['fabrica_assisted_contract'] == loaded['metadata']['fabrica_assisted_contract']
+            for p in loaded['phases']))
+    report = {'passed': True, 'checks': checks, 'original_phases': len(original['phases']),
+              'assisted_phases': len(result['phases']), 'real_loader_checked': args.real_loader,
+              'simulation_initialized': False,
+              'scope': 'offline compiler adapter regression; not worker preflight or native success'}
+    if args.output:
+        args.output.parent.mkdir(parents=True, exist_ok=True)
+        args.output.write_text(json.dumps(report, indent=2) + '\n')
+    print(json.dumps(report, indent=2))
+
+
+if __name__ == '__main__':
+    main()
