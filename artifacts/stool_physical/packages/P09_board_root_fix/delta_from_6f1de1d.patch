+def cap_staging_pad(task: dict, targets: list[dict], spec: dict) -> dict | None:
+    """Visible static box under all staging footprints.
+
+    The board is an exact triangle mesh whose flat top has vertices only on hole
+    rims; SDF parts are contact-sampled against those vertices, so an 18 mm cap
+    rests tilted ~12 deg on a few rim vertices (smoke24-27). A primitive box gives
+    a flat support. It is a passive fixture: it constrains no part.
+    """
+    cfg = _cap_regrasp_settings(spec)
+    if cfg is None or cfg['pad_margin'] is None:
+        return None
+    parts = {str(p['part_id']): p for p in task['parts']}
+    by_name = {t['name']: t for t in cap_regrasp_targets(task, targets, spec)}
+    xs, ys = [], []
+    for pid in cfg['parts']:
+        staged = by_name[f'part_{pid}_staged']
+        lo, hi = parts[pid]['bbox_min'], parts[pid]['bbox_max']
+        corners = [quat_rotate(staged['orientation'], [x, y, 0.0]) for x in (lo[0], hi[0]) for y in (lo[1], hi[1])]
+        xs += [staged['position'][0] + c[0] for c in corners]
+        ys += [staged['position'][1] + c[1] for c in corners]
+    margin = cfg['pad_margin']
+    x0, x1, y0, y1 = min(xs) - margin, max(xs) + margin, min(ys) - margin, max(ys) + margin
+    any_assembled = next(t for t in targets if t['name'] == f"part_{cfg['parts'][0]}_assembled")
+    top_z = float(any_assembled['position'][2]) + cfg['pad_height']
+    return {
+        'name': 'cap_staging_pad',
+        'kind': 'static_cube',
+        'prim_path': '/cap_staging_pad',
+        'position': [0.5 * (x0 + x1), 0.5 * (y0 + y1), top_z - 0.5 * cfg['pad_height']],
+        'orientation': [1.0, 0.0, 0.0, 0.0],
+        'scale': [x1 - x0, y1 - y0, cfg['pad_height']],
+        'color': [0.55, 0.55, 0.58],
+        'visible': True,
+        'tracked': False,
+        'static_friction': 0.8,
+        'dynamic_friction': 0.6,
+        'restitution': 0.0,
+    }
+
+
+def _deepen_grasp(phase: dict, deeper: float) -> None:
+    """Move the TCP `deeper` metres further along the grasp approach (object frame)."""
+    skill = phase.get('local_skill') or {}
+    if 'grasp_relative_position' in skill:
+        approach = quat_rotate(skill['grasp_relative_orientation'], [0.0, 0.0, 1.0])
+        skill['grasp_relative_position'] = [float(p + deeper * a) for p, a in zip(skill['grasp_relative_position'], approach)]
+    for attach in phase.get('attach', []):
+        target = attach.get('target') or {}
+        if 'offset' in target:
+            # Object-in-TCP offset; the approach is TCP +z, so the object moves -z in the TCP frame.
+            rel = skill['grasp_relative_position']
+            inverse = quat_conjugate(skill['grasp_relative_orientation'])
+            expected = [-v for v in quat_rotate(inverse, rel)]
+            target['offset'] = expected
+            if math.dist([float(v) for v in target['orientation']],
+                         [float(v) for v in inverse]) > 1e-6 and math.dist(
+                             [float(v) for v in target['orientation']], [-float(v) for v in inverse]) > 1e-6:
+                raise ValueError(f"{phase['name']}: attach orientation is not the inverse grasp rotation")
+
+
+def _add_cap_regrasps(phases: list[dict], *, spec: dict) -> None:
+    cfg = _cap_regrasp_settings(spec)
+    if cfg is None:
+        return
+    for pid in cfg['parts']:
+        names = {ph['name']: i for i, ph in enumerate(phases)}
+        prefix = next((n.removesuffix('_pickup_clearance') for n in names
+                       if n.startswith('assemble_') and n.endswith(f'_part_{pid}_pickup_clearance')), None)
+        if prefix is None:
+            raise ValueError(f'physical_cap_regrasp: part {pid} pickup_clearance phase not found')
+
+        def clone(suffix, new_suffix):
+            phase = copy.deepcopy(phases[names[f'{prefix}_{suffix}']])
+            phase['name'] = f'{prefix}_{new_suffix}'
+            return phase
+
+        obj = phases[names[f'{prefix}_close_and_attach']]['local_skill']['object']
+        hover = clone('assembly_clearance', 'stage_hover')
+        hover['local_skill']['target_object_target'] = f'part_{pid}_stage_hover'
+        place = clone('pickup_clearance', 'stage_place')
+        place['local_skill']['target_object_target'] = f'part_{pid}_staged'
+        place['local_skill']['target_object_position_tolerance'] = cfg['place_position_tolerance_m']
+        # The tray edge grip is shallow: carry it to the pad gentler than the
+        # fast transport (smoke29 drop) but fast enough for the ~1.6 rad
+        # tray-to-upright turn. Budget the timeout with the same braking law
+        # the physical pass uses (Plumbers defaults overran 4800 steps, smoke30).
+        speed, acceleration, lookahead = 0.25, 1.0, 0.020
+        interval_dv = acceleration / 240
+        budget = min(speed, math.sqrt(interval_dv**2 + acceleration * 0.9 * lookahead) - interval_dv)
+        rotation_steps = math.ceil(240 * (math.pi / budget + 2 * budget / acceleration + 5.0))
+        for phase in (hover, place):
+            phase['local_skill'].update(physical_rotation_speed=speed, physical_rotation_acceleration=acceleration,
+                                        physical_rotation_lookahead=lookahead,
+                                        cartesian_orientation_command_lookahead=lookahead)
+            phase['timeout_steps'] = max(int(phase['timeout_steps']), rotation_steps)
+        release = clone('release', 'stage_release')
+        robot = next(iter(release['gripper_commands']))
+        release['advance'] = {'type': 'all_of', 'min_steps': 24, 'conditions': [
+            {'type': 'objects_released', 'objects': [obj]},
+            {'type': 'gripper_open', 'robot': robot, 'minimum_openness': 0.95}]}
+        retreat = clone('retreat', 'stage_retreat')
+        regrasp = []
+        for suffix in ('move_above', 'preshape', 'descend', 'close_and_attach', 'lift'):
+            phase = clone(suffix, f'regrasp_{suffix}')
+            _deepen_grasp(phase, cfg['regrasp_deeper_m'])
+            regrasp.append(phase)
+        at = names[f'{prefix}_pickup_clearance'] + 1
+        phases[at:at] = [hover, place, release, retreat, *regrasp]
+
+
+def _add_socket_rebases(phases: list[dict], *, spec: dict, success: list[dict]) -> None:
+    """Before picking a part, re-anchor its assembly targets on its real socket.
+
+    Released legs stand with socket play (0.7-4.7 deg); a 95 mm leg then moves
+    its peg top 1-7 mm from the base-rebased nominal, and a cap following the
+    nominal path cannot seat (R03/R04 cap 0). The same measured-pose rebase the
+    original contract applies to the base is applied to the socket part, but
+    only to the dependent part's own assembly-side targets (anchor kept).
+    """
+    mapping = spec.get('physical_rebase_targets_to_socket', {})
+    if not isinstance(mapping, dict):
+        raise ValueError('physical_rebase_targets_to_socket must map part ids to socket part ids')
+    if not mapping:
+        return
+    tolerances = {str(e['object']).rsplit('_', 1)[-1]: e for e in success}
+    robot = str(spec.get('assembly_robot', 'franka_left'))
+    for part_id, socket_id in mapping.items():
+        part_id, socket_id = str(part_id), str(socket_id)
+        if part_id not in tolerances or socket_id not in tolerances:
+            raise ValueError(f'physical_rebase_targets_to_socket: unknown part {part_id} or socket {socket_id}')
+        tag = f'_part_{part_id}_'
+        names = []
+        for phase in phases:
+            if tag not in phase['name'] or not phase['name'].startswith('assemble_'):
+                continue
+            skill = phase.get('local_skill') or {}
+            for key in ('target_object_target', 'target_object_final_target'):
+                name = skill.get(key)
+                if (isinstance(name, str) and name.startswith(f'part_{part_id}_') and 'pickup' not in name
+                        and 'stage' not in name):
+                    names.append(name)
+        names = list(dict.fromkeys(names))
+        if f'part_{part_id}_assembled' not in names:
+            raise ValueError(f'part {part_id}: no assembled target to re-anchor')
+        index = next((i for i, ph in enumerate(phases)
+                      if ph['name'].startswith('assemble_') and ph['name'].endswith(f'_part_{part_id}_move_above')), None)
+        if index is None:
+            raise ValueError(f'part {part_id}: move_above phase not found')
+        prefix = phases[index]['name'].removesuffix('_move_above')
+        socket = tolerances[socket_id]
+        socket_object = str(socket['object'])
+        phases.insert(index, {
+            'name': f'{prefix}_rebase_to_socket',
+            'timeout_steps': 120,
+            'robot_targets': {},
+            'gripper_commands': {robot: 'open'},
+            'rebase_from_object': {
+                'object': socket_object,
+                'anchor_target': f'part_{socket_id}_assembled',
+                'targets': names,
+                'position_tolerance': float(socket['position_tolerance']),
+                'orientation_tolerance': float(socket['orientation_tolerance']),
+                'require_released': True,
+                'keep_anchor_target': True,
+            },
+            'advance': {'type': 'targets_rebased', 'object': socket_object},
+        })
+
+
+def _add_limited_releases(phases: list[dict], *, spec: dict) -> None:
+    """Open only enough to clear the part when neighbours are already seated.
+
+    A full 85 mm Robotiq opening sweeps a finger into the adjacent leg/cap and
+    the vertical retreat then drags it over (smoke34: leg 1 release tipped leg
+    3 to 27 deg and dropped cap 6). Same skill and force-cleared gate as the
+    Plumbers pin release; the jaw keeps that aperture until the retreat ends.
+    """
+    raw = spec.get('physical_limited_release')
+    if not raw:
+        return
+    config = dict(openness=0.34, minimum_openness=0.33, joint_rate=0.2, clear_force_steps=6, retreat_distance_m=0.10)
+    if not isinstance(raw, dict) or set(raw) - set(config) - {'parts'}:
+        raise ValueError('physical_limited_release needs parts plus known settings')
+    parts = [str(p) for p in raw.get('parts', [])]
+    config.update({k: v for k, v in raw.items() if k != 'parts'})
+    if (
+        not parts
+        or type(config['clear_force_steps']) is not int
+        or not 2 <= config['clear_force_steps'] <= 30
+        or not 0 < config['minimum_openness'] <= config['openness'] < 0.5
+        or not 0 < config['joint_rate'] <= 1.0
+        or not 0.04 <= config['retreat_distance_m'] <= 0.15
+    ):
+        raise ValueError('Invalid physical_limited_release aperture, rate, force or retreat settings')
+    from toolkits.factory_dual_franka_assembly.ur5e_skill_api import UR5E_ASSEMBLY_ADAPTER
+
+    for part in parts:
+        release = next((p for p in phases if p['name'].endswith(f'_part_{part}_release')), None)
+        if release is None or len(release.get('detach') or []) != 1:
+            raise ValueError(f'physical_limited_release: no single-object release for part {part}')
+        prefix = release['name'].removesuffix('_release')
+        retreat = next((p for p in phases if p['name'] == prefix + '_retreat'), None)
+        robot = next(iter(release.get('gripper_commands') or {}), None)
+        if retreat is None or robot is None or (retreat.get('local_skill') or {}).get('robot') != robot:
+            raise ValueError(f'physical_limited_release: part {part} needs its release and retreat')
+        obj = release['detach'][0]['object']
+        release['local_skill'] = {
+            'name': 'ur5e_release_supported_part', 'adapter': UR5E_ASSEMBLY_ADAPTER, 'robot': robot,
+            'object': obj, 'requires_held_object': False, 'require_success': True, 'fallback': 'fail',
+            'release_openness': config['openness'], 'release_joint_rate': config['joint_rate']}
+        release['physical_gripper_release'] = dict(
+            robot=robot, object=obj, minimum_openness=config['minimum_openness'],
+            clear_force_steps=config['clear_force_steps'])
+
+        def limited_gate(condition):
+            if condition.get('type') == 'gripper_open' and condition.get('robot') == robot:
+                condition['minimum_openness'] = config['minimum_openness']
+            for child in condition.get('conditions', []):
+                limited_gate(child)
+
+        limited_gate(release['advance'])
+        retreat['local_skill'].update(
+            gripper_command=config['openness'], offset=[0.0, 0.0, config['retreat_distance_m']])
+        retreat.setdefault('gripper_commands', {})[robot] = config['openness']
+
