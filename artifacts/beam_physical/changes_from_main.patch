+        for forces in [(8.1,8.2),(1.,41.)]:
+            with self.subTest(forces=forces):
+                state,out=self.replay(8.,[forces]*8)
+                self.assertFalse(any(x['updated'] for x in out))
+                self.assertNotIn('force_recenter_pending',state)
+
+    def test_force_regulation_and_capture_band_are_unmodified(self):
+        spec=dict(close_force_low=4.,close_force_high=12.,close_force_limit=40.,
+            close_force_weak_side_preload=True,close_force_max_seek=.03,
+            close_force_joint_rate=.025,close_force_max_command_lead=.001)
+        state=dict(contact_control_active=True,contact_capture_closure=.70,
+            contact_command_closure=.715)
+        before=copy.deepcopy(spec)
+        for left,right in [(3.9,11.),(8.,8.),(8.,12.1),(8.,41.)]:
+            result=Adapter._contact_close_control(state=copy.deepcopy(state),spec=spec,
+                metrics=metrics(left,right),gripper_q=.715,open_q=0.,closed_q=.8,
+                requested_openness=.1,min_openness=0.)
+            self.assertEqual(result['clamp_force_ready'],4.<=min(left,right) and max(left,right)<=12.)
