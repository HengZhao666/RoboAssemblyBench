+"""Offline contract regressions; these do not certify native physics."""
+import copy
+import sys
+import unittest
+from types import SimpleNamespace as NS
+from unittest.mock import patch
+
+import numpy as np
+
+from toolkits.factory_dual_franka_assembly.beam_assisted_state import BeamAssistedState, consecutive_native_gate
+
+
+def stamp(index):
+    return {'valid': True, 'epoch': 0, 'index': index, 'time': index / 240., 'dt': 1 / 240.}
+
+
+class Task(BeamAssistedState):
+    def __init__(self):
+        self.clock = stamp(1)
+        self._beam_assisted_enabled = True
+        self._fabrica_assisted_contract = {
+            'adapter': 'stool_circular_ur5e_v1', 'objects': ['part'],
+            'final_phase_name': 'stool_final', 'final_target_names': {'part': 'goal'},
+            'install_position_step_m': .00025, 'install_orientation_step_rad': .012,
+            'contact_stable_physics_steps': 12, 'release_stable_physics_steps': 72,
+            'final_stable_physics_steps': 72, 'stable_position_drift_m': .002,
+            'stable_orientation_drift_rad': .05, 'gripper_open_joint_tolerance_rad': .02}
+        self.robots = {name: NS(_action_batch_sequence=5) for name in ('left', 'right')}
+        self._attachments = {}
+        self.events = []
+
+    def _beam_physics_stamp(self):
+        return dict(self.clock)
+
+    def _assisted_event(self, event, **detail):
+        self.events.append((event, detail))
+
+    @staticmethod
+    def actions():
+        return {name: {'arm_joint_controller': [[0.] * 6], 'gripper_controller': [1.]}
+                for name in ('left', 'right')}
+
+
+class RuntimeContractTests(unittest.TestCase):
+    @staticmethod
+    def installation_task_and_usd():
+        task = Task()
+        task.step_counter = 8
+        task._assisted_install_alignment = {'part': {
+            'complete': False, 'joint_path': '/support', 'release_robot': None,
+            'position': np.zeros(3), 'orientation': np.array([1., 0., 0., 0.]),
+            'target_position': np.array([.001, 0., 0.]),
+            'target_orientation': np.array([1., 0., 0., 0.])}}
+        writes = []
+        joint = NS(GetLocalPos1Attr=lambda: NS(Set=lambda value: writes.append(('position', value))),
+                   GetLocalRot1Attr=lambda: NS(Set=lambda value: writes.append(('orientation', value))))
+        external_modules = {'pxr': NS(
+            Gf=NS(Vec3f=lambda *values: tuple(values), Quatf=lambda *values: tuple(values)),
+            UsdPhysics=NS(FixedJoint=NS(Get=lambda *args: joint))),
+            'isaacsim.core.utils.stage': NS(get_current_stage=lambda: object())}
+        return task, writes, external_modules
+
+    def test_real_support_guard_detail_logs_once_and_advances_anchor(self):
+        task, writes, modules = self.installation_task_and_usd()
+        # This matches StoolMeshGuard.support_guard's actual returned fields,
+        # including its own object identity that previously duplicated kwargs.
+        detail = {'passed': True, 'object': 'part', 'physics_stamp': dict(task.clock),
+                  'samples': 2, 'first_failure': None, 'last_sample': {'collisions': []},
+                  'scope': 'native part to proposed installation anchor finite sweep before joint authoring'}
+        task._fabrica_production_support_guard = lambda *args: detail
+        with patch.dict(sys.modules, modules):
+            task._assisted_update_install_alignment()
+        self.assertEqual(len(writes), 2)
+        np.testing.assert_allclose(task._assisted_install_alignment['part']['position'], [.00025, 0., 0.])
+        events = [payload for event, payload in task.events if event == 'fabrica_installation_support_guard']
+        self.assertEqual(events, [detail])
+        self.assertEqual(detail['object'], 'part')
+
+    def test_support_guard_identity_or_clock_mismatch_cannot_write_anchor(self):
+        for override in ({'object': 'wrong_part'}, {'physics_stamp': stamp(2)}, {'passed': False}):
+            task, writes, modules = self.installation_task_and_usd()
+            detail = {'passed': True, 'object': 'part', 'physics_stamp': dict(task.clock), **override}
+            task._fabrica_production_support_guard = lambda *args: detail
+            with patch.dict(sys.modules, modules), self.assertRaisesRegex(RuntimeError, 'rejected or stale'):
+                task._assisted_update_install_alignment()
+            self.assertEqual(writes, [])
+            np.testing.assert_array_equal(task._assisted_install_alignment['part']['position'], np.zeros(3))
+
+    def test_all_stool_body_rewrites_are_rejected_but_untracked_environment_is_not(self):
+        t = Task()
+        for operation in ('pose write', 'velocity reset', 'collision disable', 'gravity disable'):
+            with self.assertRaises(RuntimeError):
+                t._assisted_forbid_body_rewrite('part', operation)
+        t._assisted_forbid_body_rewrite('environment', 'pose write')
+
+    def test_missing_geometry_guard_fails_closed(self):
