+                self.assertLessEqual(state['force_recenter_travel']+state['recenter_feedback_travel'],.002)
+                np.testing.assert_array_equal(state['contact_arm_anchor']['position'],np.zeros(3))
+                previous=np.array(action['arm_joint_controller'][0])
+                adapter._solve_ik=lambda **kw: (_ for _ in ()).throw(AssertionError('holding command re-solved IK'))
+                task.step_counter+=1;task.phase_step_counter+=1
+                next_action=act()
+                np.testing.assert_allclose(next_action['arm_joint_controller'][0],previous,atol=1e-12)
+
+    def test_frozen_real_feedback_cannot_be_acknowledged(self):
+        *_,action,_,_=self.run_model(True,.00008,frozen=True)
+        self.assertTrue(action.get('__local_skill_failure__'))
+        self.assertEqual(action.get('reason'),'close_recenter_motion_timeout')
