+class CaptureBalanceBand(unittest.TestCase):
+    # Native r30 steps15660--15672, original close_control_trace forces.
+    cycle = [
+        (4.209083772202936, 13.005067401616435),
+        (3.8699569693657154, 13.101124745448063),
+        (3.4615861657637614, 12.971646596771704),
+        (2.965347131887271, 12.63927812537806),
+        (2.3957138357975567, 12.032714250321598),
+        (1.857358328681141, 11.349093814640879),
+        (1.7582360895182938, 10.504852348048766),
+        (1.8931654216139984, 10.171280813834644),
+        (2.1507343972016226, 10.109438260566652),
+        (2.5269417076382332, 10.408689935326452),
+        (2.9644366931643127, 10.772096374956172),
+        (3.5288503852594624, 11.362830289622204),
+        (4.057686549807056, 11.979886247946961),
+    ]
+
+    def spec(self, target):
+        return dict(close_force_recenter_track_weak_side=True,
+            close_force_recenter_single_contact_full_step=True,
+            physical_contact_axes='y', close_force_balance_min=target,
+            close_force_balance_peak=4., close_force_high=12.,
+            close_force_limit=40., contact_force_threshold=.1,
+            close_gate_recenter_stable_steps=4, close_force_balance_step=.000025,
+            close_gate_recenter_step=.0002, close_gate_recenter_max_offset=.002,
+            close_force_recenter_measure_progress=True,
+            close_force_recenter_stop_on_bilateral=True)
+
+    def replay(self, target, sequence):
+        state={'close_tcp_position_world':np.zeros(3)};out=[]
+        for tick,(left,right) in enumerate(sequence,15660):
+            state['force_recenter_observation_step']=tick
+            result=Adapter._update_force_recenter(state=state,
+                spec=self.spec(target),metrics=metrics(left,right))
+            out.append(result)
+            if result.get('updated'):break
+        return state,out
